# Docker Compose host settings
TZ=UTC

# Required by the production-oriented configs/config.yaml sample.
# Generate both values with a secret manager or a cryptographically secure
# random generator; never reuse these example values.
STREMDBC_JWT_SECRET=SET_ME_JWT_SECRET
STREMDBC_API_KEY=SET_ME_API_KEY
STREMDBC_CORS_ORIGIN=http://localhost:8080

# Optional monitoring profile
GRAFANA_ADMIN_PASSWORD=SET_ME_GRAFANA_PASSWORD

# Optional cluster profile
POSTGRES_DB=stremdbc
POSTGRES_USER=stremdbc
POSTGRES_PASSWORD=SET_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=SET_ME_REDIS_PASSWORD

# STREMDBC application secrets are configured in configs/config.yaml or injected
# by your deployment secret manager. Do not commit real JWT secrets or API keys.
